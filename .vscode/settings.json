{
  "python.defaultInterpreterPath": "/data/dataiku/.conda/envs/env_neats/bin/python",

  // Pylint (new extension) settings:
  "pylint.args": ["--disable=C0114"],

  "python.analysis.useLibraryCodeForTypes": true,


  // Crank up type checking if you want stricter signals (optional)
  "python.analysis.typeCheckingMode": "strict",

  // If you want to quiet specific noisy pandas diagnostics:
  "python.analysis.diagnosticSeverityOverrides": {
    // Common pandas annoyances:
    "reportUnknownMemberType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownLambdaType": "none",
    "reportOptionalSubscript": "warning",  // keep this useful one if you like
    "reportMissingTypeStubs": "none"
  },

  "python.analysis.extraPaths": [
        "/data/common/dataiku2/config/projects/NEATS/lib/python/BADA"  // or wherever its __init__.py lives
    ],
    "python.analysis.autoSearchPaths": true,
    "python.analysis.usePYTHONPATH": true,

  "exclude": [
    "**/.venv",
    "**/.env",
    "**/venv",
    "**/__pycache__"
  ],
  "venvPath": ".",
  "venv": ".venv"
}